# Copia este archivo a .env y ajusta los valores.
# Nunca subas el archivo .env al repositorio.

# --- Base de datos (desarrollo) ---
POSTGRES_USER=postarix
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=postarix
DATABASE_URL=postgresql://postarix:cambia-esta-clave@localhost:5432/postarix

# --- Valkey (desarrollo) ---
VALKEY_URL=redis://localhost:6379

# --- Autenticación ---
# Genera un valor aleatorio largo, por ejemplo: openssl rand -base64 48
AUTH_SECRET=
AUTH_URL=http://localhost:3000
