# Copy this file to .env and adjust the values.
# Never commit your .env file.

# --- Database (development) ---
POSTGRES_USER=postarix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postarix
DATABASE_URL=postgresql://postarix:change-me@localhost:5432/postarix

# --- Valkey (development) ---
VALKEY_URL=redis://localhost:6379

# --- API ---
PORT=3000

# Public URL of the API (used by Better Auth for cookies and callbacks).
AUTH_URL=http://localhost:3000

# Secret of at least 32 characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Browser origins allowed to call the API (admin and webmail), comma-separated.
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002

# Trusted reverse proxies (IPs or CIDRs), comma-separated.
# Empty = the API receives connections directly and X-Forwarded-For is ignored.
# Example with Traefik on the Docker network: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# Public self-registration. Disabled for security.
ALLOW_SIGNUP=false

# Allow regular users to create organizations. By default only super-admins can.
ALLOW_USER_CREATE_ORG=false
