# Copia este archivo a .env y ajusta los valores.
# Nunca subas el archivo .env al repositorio.

# --- Base de datos (desarrollo) ---
POSTGRES_USER=postarix
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=postarix
DATABASE_URL=postgresql://postarix:cambia-esta-clave@localhost:5432/postarix

# --- Valkey (desarrollo) ---
VALKEY_URL=redis://localhost:6379

# --- API ---
PORT=3000

# URL pública de la API (la usa Better Auth para cookies y callbacks).
AUTH_URL=http://localhost:3000

# Secreto de al menos 32 caracteres. Genera uno con: openssl rand -base64 48
AUTH_SECRET=

# Orígenes del navegador autorizados (panel y webmail), separados por comas.
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002

# Proxies inversos de confianza (IPs o CIDR), separados por comas.
# Vacío = la API recibe las conexiones directamente y se ignora X-Forwarded-For.
# Ejemplo con Traefik en la red de Docker: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# Registro público de cuentas. Por seguridad, desactivado.
ALLOW_SIGNUP=false

# Permitir que usuarios normales creen organizaciones. Por defecto solo los super-admins.
ALLOW_USER_CREATE_ORG=false
