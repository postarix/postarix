# Generated at container start.
# Spam for an alias (Rspamd turns sales@example.com into sales+Junk@example.com,
# see rspamd.local.lua): hosted destinations get "+Junk" too, so the message is
# filed in their Junk folder. Spam is never forwarded to outside destinations:
# they get the discard address instead (see transport_maps in the entrypoint).
# Mailboxes are in mail.aliases too (mapped to themselves), and an address no
# mailbox or alias has goes to the domain's catch-all, if any. (No SQL comments
# in the query: Postfix joins its lines into one.)
hosts = ${POSTFIX_DB_HOST}
user = ${POSTFIX_DB_USER}
password = ${POSTFIX_DB_PASSWORD}
dbname = ${POSTFIX_DB_NAME}
query = SELECT CASE
    WHEN EXISTS (SELECT 1 FROM mail.mailboxes mb WHERE mb.address = regexp_replace(al.destination, '[+][^@]*@', '@'))
      OR EXISTS (SELECT 1 FROM mail.aliases inner_al WHERE inner_al.address = regexp_replace(al.destination, '[+][^@]*@', '@'))
    THEN split_part(split_part(al.destination, '@', 1), '+', 1) || '+Junk@' || split_part(al.destination, '@', 2)
    ELSE 'spam@discard.postarix.invalid'
  END
  FROM mail.aliases al
  WHERE position('+junk@' IN lower('%s')) > 0
    AND (al.address = replace(lower('%s'), '+junk@', '@')
      OR (al.address = '@' || split_part(lower('%s'), '@', 2)
        AND NOT EXISTS (SELECT 1 FROM mail.aliases x WHERE x.address = replace(lower('%s'), '+junk@', '@'))))
