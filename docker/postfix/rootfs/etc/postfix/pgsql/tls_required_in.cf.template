# Generated at container start. Mailboxes that only accept mail over TLS: a
# message for them from a server that did not start TLS is refused.
hosts = ${POSTFIX_DB_HOST}
user = ${POSTFIX_DB_USER}
password = ${POSTFIX_DB_PASSWORD}
dbname = ${POSTFIX_DB_NAME}
query = SELECT 'reject_plaintext_session' FROM mail.tls_required_in WHERE address = '%s'
