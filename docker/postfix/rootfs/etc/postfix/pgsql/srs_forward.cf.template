# Generated at container start. Envelope sender of mail forwarded by Sieve
# (port 10588 only, see the cyrus-cleanup service): an SRS0 address.
hosts = ${POSTFIX_DB_HOST}
user = ${POSTFIX_DB_USER}
password = ${POSTFIX_DB_PASSWORD}
dbname = ${POSTFIX_DB_NAME}
query = SELECT v FROM (SELECT mail.srs_forward('%s', '${MAIL_HOSTNAME}') AS v) t WHERE v IS NOT NULL
