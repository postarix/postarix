# Generated at container start.
# Mail to a mailbox with a tag (ann+news@example.com) keeps the tag on its way
# to Cyrus, so the person's Sieve script can file it by tag (mailboxes are in
# mail.aliases mapped to themselves, which would otherwise drop it). An address
# that maps to itself is final for Postfix. Tags on aliases are dropped as
# before. (No SQL comments in the query: Postfix joins its lines into one.)
hosts = ${POSTFIX_DB_HOST}
user = ${POSTFIX_DB_USER}
password = ${POSTFIX_DB_PASSWORD}
dbname = ${POSTFIX_DB_NAME}
query = SELECT lower('%s') FROM mail.mailboxes mb
  WHERE position('+' IN '%s') > 0
    AND mb.address = regexp_replace(lower('%s'), '[+][^@]*@', '@')
