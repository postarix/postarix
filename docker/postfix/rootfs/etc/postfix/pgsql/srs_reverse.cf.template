# Generated at container start. A bounce sent to an SRS0 address goes back to
# the original sender of the forwarded message.
hosts = ${POSTFIX_DB_HOST}
user = ${POSTFIX_DB_USER}
password = ${POSTFIX_DB_PASSWORD}
dbname = ${POSTFIX_DB_NAME}
query = SELECT v FROM (SELECT mail.srs_reverse('%s') AS v) t WHERE v IS NOT NULL
