# Generated at container start. Senders whose mail leaves only over TLS: their
# outgoing mail uses the postarix-tls transport (TLS required; it waits and
# eventually bounces rather than going out in clear).
hosts = ${POSTFIX_DB_HOST}
user = ${POSTFIX_DB_USER}
password = ${POSTFIX_DB_PASSWORD}
dbname = ${POSTFIX_DB_NAME}
query = SELECT 'postarix-tls:' FROM mail.tls_required_out WHERE address = '%s'
