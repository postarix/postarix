# Generated at container start.
# Allowed and blocked networks of the whole server (System → IP access), see
# mail.client_access(). (No SQL comments in the query: Postfix joins its lines.)
hosts = ${POSTFIX_DB_HOST}
user = ${POSTFIX_DB_USER}
password = ${POSTFIX_DB_PASSWORD}
dbname = ${POSTFIX_DB_NAME}
query = SELECT mail.client_access('%s') AS action WHERE mail.client_access('%s') IS NOT NULL
