#!/bin/sh
# Renders Postfix configuration from the environment and runs Postfix in the foreground.
set -eu

# Shared with CrowdSec through the logs volume.
LOG_DIR=/var/log/postarix
LOG_FILE=$LOG_DIR/postfix.log
mkdir -p "$LOG_DIR"

: "${MAIL_HOSTNAME:?MAIL_HOSTNAME is required (the public name of the mail server)}"
: "${POSTFIX_DB_PASSWORD:?POSTFIX_DB_PASSWORD is required}"
export POSTFIX_DB_HOST="${POSTFIX_DB_HOST:-postgres}"
export POSTFIX_DB_NAME="${POSTFIX_DB_NAME:-postarix}"
export POSTFIX_DB_USER="${POSTFIX_DB_USER:-postarix_mail}"
export POSTFIX_DB_PASSWORD
RSPAMD_MILTER="${RSPAMD_MILTER:-inet:rspamd:11332}"
# LMTP to Cyrus over a Unix socket on a volume shared with the cyrus container:
# unlike a TCP port, it cannot be reached from the network (LMTP is pre-authenticated).
CYRUS_LMTP="${CYRUS_LMTP:-unix:/run/cyrus-lmtp/lmtp}"
MESSAGE_SIZE_LIMIT="${MESSAGE_SIZE_LIMIT:-52428800}"
CERT_DIR="${CERT_DIR:-/certs}"

log() { echo "[postfix-entrypoint] $*"; }

# --- PostgreSQL maps (contain the database password: postfix-readable only) ---
for template in /etc/postfix/pgsql/*.cf.template; do
  target="${template%.template}"
  envsubst '${POSTFIX_DB_HOST} ${POSTFIX_DB_USER} ${POSTFIX_DB_PASSWORD} ${POSTFIX_DB_NAME} ${MAIL_HOSTNAME}' \
    < "$template" > "$target"
  chown root:postfix "$target"
  chmod 0640 "$target"
done

# --- TLS ------------------------------------------------------------------------
# Certificates come from the shared /certs volume (managed by the certs service).
install_certificates() {
  install -d -m 0755 /etc/postfix/tls
  if [ -s "$CERT_DIR/fullchain.pem" ] && [ -s "$CERT_DIR/privkey.pem" ]; then
    install -m 0600 "$CERT_DIR/privkey.pem" /etc/postfix/tls/privkey.pem
    install -m 0644 "$CERT_DIR/fullchain.pem" /etc/postfix/tls/fullchain.pem
    return 0
  fi
  return 1
}
if ! install_certificates; then
  log "no certificate in $CERT_DIR; generating a self-signed one (development only)"
  openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj "/CN=$MAIL_HOSTNAME" \
    -addext "subjectAltName=DNS:$MAIL_HOSTNAME" \
    -keyout /etc/postfix/tls/privkey.pem -out /etc/postfix/tls/fullchain.pem 2>/dev/null
  chmod 0600 /etc/postfix/tls/privkey.pem
fi

# Reload when the certificate is renewed.
watch_certificates() {
  while sleep 60; do
    if [ -s "$CERT_DIR/fullchain.pem" ] && ! cmp -s "$CERT_DIR/fullchain.pem" /etc/postfix/tls/fullchain.pem; then
      install_certificates && postfix reload && log "certificate changed; Postfix reloaded"
    fi
  done
}

# Replies to forwarded mail (SRS0 addresses on the server's name): bounces and
# automatic replies only, never ordinary mail through the server.
host_re=$(printf '%s' "$MAIL_HOSTNAME" | sed 's/[.]/\\./g')
printf '/^srs[01][=+-].*@%s$/ postarix_srs_bounces\n' "$host_re" > /etc/postfix/srs_recipients.regexp
# Checked first, for every client: anything but the null sender is refused;
# the address itself is then checked like any other (relay_recipient_maps).
printf '%s\n' '/^<>$/ DUNNO' '/./ REJECT Only delivery reports are accepted for this address' > /etc/postfix/srs_senders.regexp

# --- main.cf --------------------------------------------------------------------
# Nobody relays by address (no permit_mynetworks below): not even processes on
# this host, or on Kubernetes in this pod, may send without logging in.
pg() { echo "pgsql:/etc/postfix/pgsql/$1.cf"; }
postconf -e \
  "compatibility_level = 3.6" \
  "myhostname = $MAIL_HOSTNAME" \
  "myorigin = \$myhostname" \
  "mydestination = localhost" \
  "mynetworks = 127.0.0.1/32" \
  "inet_interfaces = all" \
  "inet_protocols = ipv4" \
  "maillog_file = $LOG_FILE" \
  "smtpd_banner = \$myhostname ESMTP" \
  "biff = no" \
  "append_dot_mydomain = no" \
  "readme_directory = no" \
  "alias_maps =" \
  "alias_database =" \
  "recipient_delimiter = +" \
  "message_size_limit = $MESSAGE_SIZE_LIMIT" \
  "mailbox_size_limit = 0" \
  "disable_vrfy_command = yes" \
  "smtpd_helo_required = yes" \
  "smtpd_client_auth_rate_limit = 30" \
  "smtpd_client_connection_count_limit = 20" \
  "smtpd_client_message_rate_limit = 300" \
  "anvil_rate_time_unit = 60s" \
  "virtual_mailbox_domains = $(pg domains)" \
  "virtual_mailbox_maps = $(pg mailboxes)" \
  "virtual_alias_maps = $(pg aliases), $(pg junk_aliases)" \
  "recipient_bcc_maps = $(pg archive_copies)" \
  "sender_bcc_maps = $(pg archive_copies)" \
  "propagate_unmatched_extensions = canonical" \
  "virtual_alias_domains =" \
  "virtual_transport = lmtp:$CYRUS_LMTP" \
  "transport_maps = inline:{ { discard.postarix.invalid = discard:spam for an outside alias destination } }, $(pg transport_routes)" \
  "sender_dependent_relayhost_maps = $(pg relayhost_by_sender)" \
  "smtp_tls_policy_maps = $(pg tls_policies)" \
  "smtp_sasl_auth_enable = yes" \
  "smtp_sasl_password_maps = $(pg smtp_credentials)" \
  "smtp_sasl_security_options = noanonymous, noplaintext" \
  "smtp_sasl_tls_security_options = noanonymous" \
  "smtpd_sender_login_maps = $(pg sender_logins)" \
  "smtpd_relay_restrictions = permit_sasl_authenticated, reject_unauth_destination" \
  "smtpd_recipient_restrictions = check_recipient_access regexp:/etc/postfix/srs_recipients.regexp, check_recipient_access $(pg tls_required_in), permit_sasl_authenticated, reject_unauth_destination, reject_unlisted_recipient" \
  "sender_dependent_default_transport_maps = $(pg tls_required_out)" \
  "plaintext_reject_code = 550" \
  "relay_domains = $MAIL_HOSTNAME" \
  "relay_recipient_maps = $(pg srs_recipients)" \
  "recipient_canonical_maps = $(pg srs_reverse)" \
  "recipient_canonical_classes = envelope_recipient" \
  "smtpd_restriction_classes = postarix_srs_bounces" \
  "postarix_srs_bounces = check_sender_access regexp:/etc/postfix/srs_senders.regexp" \
  "smtpd_sasl_auth_enable = no" \
  "smtpd_sasl_type = cyrus" \
  "smtpd_sasl_path = smtpd" \
  "cyrus_sasl_config_path = /etc/postfix/sasl" \
  "smtpd_sasl_security_options = noanonymous" \
  "smtpd_sasl_authenticated_header = no" \
  "smtpd_tls_chain_files = /etc/postfix/tls/privkey.pem, /etc/postfix/tls/fullchain.pem" \
  "smtpd_tls_security_level = may" \
  "smtpd_tls_auth_only = yes" \
  "smtpd_tls_protocols = >=TLSv1.2" \
  "smtpd_tls_mandatory_protocols = >=TLSv1.2" \
  "smtpd_tls_loglevel = 1" \
  "smtpd_tls_received_header = yes" \
  "smtp_dns_support_level = dnssec" \
  "smtp_tls_security_level = dane" \
  "smtp_tls_loglevel = 1" \
  "smtp_tls_CApath = /etc/ssl/certs" \
  "smtpd_milters = $RSPAMD_MILTER" \
  "non_smtpd_milters = $RSPAMD_MILTER" \
  "milter_protocol = 6" \
  "milter_default_action = tempfail" \
  "milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}"

# Outgoing mail of mailboxes that require TLS (sender_dependent_default_transport_maps):
# delivered only over TLS; without it the message waits and eventually bounces.
postconf -M "postarix-tls/unix=postarix-tls unix - - n - - smtp"
postconf -P \
  "postarix-tls/unix/syslog_name=postfix/tls-required" \
  "postarix-tls/unix/smtp_tls_security_level=encrypt" \
  "postarix-tls/unix/smtp_tls_mandatory_protocols=>=TLSv1.2"

# Submission: the null sender (bounces) is never legitimate from a client, and
# the envelope sender must be one the logged-in user owns.
postconf "postarix_submission_sender_restrictions = check_sender_access inline:{ { <> = REJECT Null sender is not allowed on submission } }, reject_sender_login_mismatch"

# --- master.cf: submission (587, STARTTLS) and submissions (465, implicit TLS) --
for service in submission smtps; do
  postconf -M "$service/inet=$service inet n - n - - smtpd"
  postconf -P \
    "$service/inet/syslog_name=postfix/$service" \
    "$service/inet/smtpd_sasl_auth_enable=yes" \
    "$service/inet/smtpd_tls_auth_only=yes" \
    "$service/inet/smtpd_client_restrictions=permit_sasl_authenticated,reject" \
    "$service/inet/smtpd_sender_restrictions=\$postarix_submission_sender_restrictions" \
    "$service/inet/smtpd_relay_restrictions=permit_sasl_authenticated,reject" \
    "$service/inet/smtpd_recipient_restrictions=permit_sasl_authenticated,reject" \
    "$service/inet/milter_macro_daemon_name=ORIGINATING"
done
# --- master.cf: internal submission ports ---------------------------------------
# 10587: webmail sending by the Postarix API. 10588: mail Cyrus sends by itself
# (Sieve redirect and vacation replies). Neither is published or on the proxy
# network. Each logs in with its own account and password, given to this
# container for that purpose only (POSTARIX_SECRET_SUBMISSION,
# POSTARIX_SECRET_CYRUS_SMTP; older installations derive them from
# INTERNAL_API_TOKEN, see apps/api/src/config/internal-secrets.ts).
internal_secret() {
  var="POSTARIX_SECRET_$(echo "$1" | tr 'a-z-' 'A-Z_')"
  value=$(printenv "$var" || true)
  if [ -n "$value" ]; then printf '%s' "$value"; return; fi
  printf 'postarix:%s' "$1" | openssl dgst -sha256 -hmac "${INTERNAL_API_TOKEN:?$var is required}" -r | cut -d' ' -f1
}
# Reports (logs, the mail queue) to the API's internal HTTPS listener, with a
# secret for that alone (POSTARIX_SECRET_REPORTS). Without it, nothing is reported.
REPORTS_SECRET=""
if [ -n "${POSTARIX_SECRET_REPORTS:-}" ] || [ -n "${INTERNAL_API_TOKEN:-}" ]; then
  REPORTS_SECRET=$(internal_secret reports)
fi
unset POSTARIX_SECRET_REPORTS

if [ -n "${POSTARIX_SECRET_SUBMISSION:-}" ] || [ -n "${INTERNAL_API_TOKEN:-}" ]; then
  rm -f /etc/postfix/sasl/sasldb2
  internal_secret submission | saslpasswd2 -p -c -u "$MAIL_HOSTNAME" -f /etc/postfix/sasl/sasldb2 postarix-api
  internal_secret cyrus-smtp | saslpasswd2 -p -c -u "$MAIL_HOSTNAME" -f /etc/postfix/sasl/sasldb2 postarix-cyrus
  chown root:postfix /etc/postfix/sasl/sasldb2
  chmod 0640 /etc/postfix/sasl/sasldb2

  # Each port accepts only its own account.
  postconf \
    "postarix_api_sender_restrictions = check_sasl_access inline:{ { postarix-api = OK } { postarix-api@$MAIL_HOSTNAME = OK } }, reject" \
    "postarix_cyrus_data_restrictions = check_policy_service unix:private/postarix-sieve-owner" \
    "postarix_cyrus_sender_restrictions = check_sasl_access inline:{ { postarix-cyrus = OK } { postarix-cyrus@$MAIL_HOSTNAME = OK } }, reject"

  # The API has already checked that the user owns the From address (Rspamd
  # then requires From = envelope sender, as on 587). It is sent over TLS
  # (STARTTLS required) so the password never crosses the network in clear.
  postconf -M "10587/inet=10587 inet n - n - - smtpd"
  postconf -P \
    "10587/inet/syslog_name=postfix/api-submit" \
    "10587/inet/smtpd_sasl_auth_enable=yes" \
    "10587/inet/smtpd_sasl_path=postarix-api" \
    "10587/inet/smtpd_sasl_local_domain=$MAIL_HOSTNAME" \
    "10587/inet/smtpd_tls_security_level=encrypt" \
    "10587/inet/smtpd_tls_auth_only=yes" \
    "10587/inet/smtpd_client_restrictions=permit_sasl_authenticated,reject" \
    "10587/inet/smtpd_sender_restrictions=\$postarix_api_sender_restrictions" \
    "10587/inet/smtpd_relay_restrictions=permit_sasl_authenticated,reject" \
    "10587/inet/smtpd_recipient_restrictions=permit_sasl_authenticated,reject" \
    "10587/inet/smtpd_client_message_rate_limit=0" \
    "10587/inet/smtpd_client_connection_count_limit=0" \
    "10587/inet/smtpd_client_auth_rate_limit=0" \
    "10587/inet/milter_macro_daemon_name=ORIGINATING"

  # Cyrus sends only vacation replies (null envelope sender) and redirects;
  # Rspamd enforces that (POSTARIX_CYRUS_SENT in rspamd.local.lua, which
  # recognizes this port by its daemon name). Redirected mail keeps its From
  # header but gets an SRS envelope sender on the server's own name (its own
  # cleanup service), so SPF passes at the destination and bounces go back
  # to the original sender.
  postconf -M "10588/inet=10588 inet n - n - - smtpd"
  postconf -P \
    "10588/inet/syslog_name=postfix/cyrus-submit" \
    "10588/inet/smtpd_sasl_auth_enable=yes" \
    "10588/inet/smtpd_sasl_path=postarix-api" \
    "10588/inet/smtpd_sasl_local_domain=$MAIL_HOSTNAME" \
    "10588/inet/smtpd_tls_security_level=none" \
    "10588/inet/smtpd_tls_auth_only=no" \
    "10588/inet/smtpd_client_restrictions=permit_sasl_authenticated,reject" \
    "10588/inet/smtpd_sender_restrictions=\$postarix_cyrus_sender_restrictions" \
    "10588/inet/smtpd_relay_restrictions=permit_sasl_authenticated,reject" \
    "10588/inet/smtpd_recipient_restrictions=permit_sasl_authenticated,reject" \
    "10588/inet/milter_macro_daemon_name=CYRUS" \
    "10588/inet/smtpd_client_auth_rate_limit=0" \
    "10588/inet/smtpd_client_connection_count_limit=0" \
    "10588/inet/smtpd_client_message_rate_limit=1200" \
    "10588/inet/cleanup_service_name=cyrus-cleanup" \
    "10588/inet/smtpd_data_restrictions=\$postarix_cyrus_data_restrictions"
  # Names the mailbox whose Sieve script is sending (see the script).
  postconf -M "postarix-sieve-owner/unix=postarix-sieve-owner unix - n n - 0 spawn user=nobody argv=/usr/local/bin/postarix-sieve-owner"
  postconf -M "cyrus-cleanup/unix=cyrus-cleanup unix n - n - 0 cleanup"
  # The envelope sender of forwarded mail becomes an SRS0 address on the
  # server's name (computed in the database: mail.srs_forward). A null sender
  # (vacation replies) and the server's own addresses are left as they are.
  postconf -P \
    "cyrus-cleanup/unix/sender_canonical_maps=$(pg srs_forward)" \
    "cyrus-cleanup/unix/sender_canonical_classes=envelope_sender"
  unset INTERNAL_API_TOKEN POSTARIX_SECRET_SUBMISSION POSTARIX_SECRET_CYRUS_SMTP
else
  postconf -MX "10587/inet" 2>/dev/null || true
  postconf -MX "10588/inet" 2>/dev/null || true
  log "no internal secrets set: webmail sending (10587) and Sieve sending (10588) are disabled"
fi

postconf -P "submission/inet/smtpd_tls_security_level=encrypt"
postconf -P "smtps/inet/smtpd_tls_wrappermode=yes"

postfix check
watch_certificates &

# The log goes to a file on the shared logs volume (read by CrowdSec) and is
# mirrored to the container output. It is rotated past 20 MB; one old copy is kept.
touch "$LOG_FILE"
tail -n 0 -F "$LOG_FILE" 2>/dev/null &
(
  while sleep 300; do
    if [ "$(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0)" -gt 20971520 ]; then
      postfix logrotate >/dev/null 2>&1 || true
      ls -1t "$LOG_FILE".* 2>/dev/null | tail -n +2 | xargs -r rm -f
    fi
  done
) &
if [ -n "$REPORTS_SECRET" ]; then
  install -d -m 0700 /etc/postarix
  printf 'POSTARIX_API_INTERNAL=%s\nMAIL_HOSTNAME=%s\n' "${POSTARIX_API_INTERNAL:-api:3443}" "$MAIL_HOSTNAME" > /etc/postarix/reports.env
  ( umask 077; printf 'x-postarix-internal-token: %s\n' "$REPORTS_SECRET" > /etc/postarix/reports.headers )
  postarix-reporter postfix "$LOG_FILE" /var/spool/postfix /etc/postfix/tls/fullchain.pem "Postfix $(postconf -h mail_version)" &
else
  log "no reports secret set: logs and the mail queue are not shown in the admin panel"
fi
unset REPORTS_SECRET

log "starting Postfix for $MAIL_HOSTNAME"
exec postfix start-fg
