#!/usr/bin/perl
# Postfix policy service for the Cyrus port (10588). Cyrus logs in with one
# account for every mailbox, but names the mailbox whose Sieve script is
# sending in the MAIL FROM AUTH= parameter (Postfix: sasl_sender). This adds
# it as a header for Rspamd (POSTARIX_CYRUS_SENT), which removes it again
# before the message leaves.
use strict;
use warnings;

$| = 1;
my %attr;
while (my $line = <STDIN>) {
  chomp $line;
  if ($line ne '') {
    my ($name, $value) = split /=/, $line, 2;
    $attr{$name} = $value // '' if defined $name;
    next;
  }
  my $owner = $attr{sasl_sender} // '';
  if ($owner =~ /\A[^\s<>@"]{1,64}\@[A-Za-z0-9.-]{1,253}\z/) {
    print "action=PREPEND X-Postarix-Sieve-Owner: $owner\n\n";
  } else {
    print "action=REJECT Unknown mailbox\n\n";
  }
  %attr = ();
}
