#!/bin/sh
set -eu
install -d -o unbound -g unbound /var/lib/unbound
# Refresh the DNSSEC root trust anchor; fall back to the packaged one when offline.
if ! unbound-anchor -a /var/lib/unbound/root.key; then
  [ -s /var/lib/unbound/root.key ] || cp /usr/share/dns/root.key /var/lib/unbound/root.key
fi
chown unbound:unbound /var/lib/unbound/root.key
exec unbound -d -c /etc/unbound/unbound.conf
