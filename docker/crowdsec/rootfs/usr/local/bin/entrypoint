#!/bin/sh
# Prepares CrowdSec (its local API, the firewall bouncer's key) and runs it
# in the foreground. Detection content is set up in the image.
set -eu

log() { echo "crowdsec-entrypoint: $*"; }

# The local API listens on the container network (published on the host's
# loopback only, for the firewall bouncer).
sed -i 's|^\(\s*listen_uri:\).*|\1 0.0.0.0:8080|' /etc/crowdsec/config.yaml

# Configuration comes from the image; the decisions database is a volume. The
# agent's own credentials are re-issued at every start so both always match.
cscli machines add postarix-agent --auto --force --url http://127.0.0.1:8080 -f /etc/crowdsec/local_api_credentials.yaml >/dev/null

# The host's firewall bouncer authenticates with this key.
if [ -n "${CROWDSEC_BOUNCER_KEY:-}" ]; then
  if ! cscli bouncers list -o raw 2>/dev/null | grep -q '^host-firewall,'; then
    cscli bouncers add host-firewall -k "$CROWDSEC_BOUNCER_KEY" >/dev/null
    log "registered the host-firewall bouncer"
  fi
else
  log "CROWDSEC_BOUNCER_KEY not set: decisions are made but nothing blocks them"
fi
unset CROWDSEC_BOUNCER_KEY

mkdir -p /var/log/postarix
exec crowdsec -c /etc/crowdsec/config.yaml
