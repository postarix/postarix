# Generated at container start from /etc/imapd.conf.template.
configdirectory: /var/lib/cyrus
proc_path: /run/cyrus/proc
mboxname_lockpath: /run/cyrus/lock
defaultpartition: default
partition-default: /var/spool/cyrus/mail
sievedir: /var/spool/sieve
servername: ${MAIL_HOSTNAME}

# One namespace per domain; users log in with their full address.
virtdomains: userid
unixhierarchysep: yes
altnamespace: yes
lmtp_downcase_rcpt: yes
hashimapspool: true
umask: 077

# Authentication: every mailbox login goes through saslauthd to the Postarix
# API. The internal admin account (sasldb) can only log in on the admin
# service, whose configuration (imapd-admin.conf) switches to auxprop.
sasl_pwcheck_method: saslauthd
sasl_auxprop_plugin: sasldb
sasl_mech_list: PLAIN LOGIN
sasl_saslauthd_path: /run/saslauthd/mux
allowplaintext: no
allowanonymouslogin: no
# The HTTP service speaks plain HTTP on the internal network: TLS ends at the
# reverse proxy. Without this, Cyrus redirects every request to https and
# clients behind the proxy loop forever.
http_allowplaintext: yes

# TLS. Cyrus 3.10+ only offers STARTTLS when allowed explicitly.
allowstarttls: yes
tls_server_cert: /etc/cyrus-tls/fullchain.pem
tls_server_key: /etc/cyrus-tls/privkey.pem
tls_client_ca_dir: /etc/ssl/certs
tls_versions: tls1_2 tls1_3
tls_session_timeout: 1440

# Calendars and contacts. JMAP (for the webmail) is not exposed here: a
# DAV-scoped app password must not give access to mail. The conversations
# database is kept enabled for the JMAP service added with the webmail.
httpmodules: caldav carddav
conversations: yes
conversations_db: twoskip
specialusealways: yes

# Full-text search (IMAP SEARCH and JMAP Email/query) with Xapian. New mail is
# indexed by the rolling squatter (cyrus.conf), fed through the sync log.
search_engine: xapian
search_index_headers: yes
search_batchsize: 8192
defaultsearchtier: t1
t1searchpartition-default: /var/lib/cyrus/search
sync_log: yes
sync_log_channels: squatter

# Quotas, Sieve
quota_db: quotalegacy
sieve_maxscriptsize: 64
sieve_maxscripts: 5
sieve_extensions: fileinto reject vacation vacation-seconds imap4flags notify envelope relational regex subaddress copy date index body mailbox mboxmetadata servermetadata variables

imapidresponse: no
syslog_prefix: cyrus
