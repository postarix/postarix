#!/bin/sh
# Prepares configuration, TLS, the admin account and saslauthd, then runs Cyrus.
set -eu

: "${MAIL_HOSTNAME:?MAIL_HOSTNAME is required (the public name of the mail server)}"
: "${CYRUS_ADMIN_PASSWORD:?CYRUS_ADMIN_PASSWORD is required}"
: "${INTERNAL_API_TOKEN:?INTERNAL_API_TOKEN is required}"
# The API's internal HTTPS listener (host:port), for the mail-login bridge.
POSTARIX_API_INTERNAL="${POSTARIX_API_INTERNAL:-api:3443}"
CERT_DIR="${CERT_DIR:-/certs}"
# standalone (one Cyrus), or a part of a Cyrus Murder: backend (holds
# mailboxes), frontend (where clients and Postfix connect; routes each user to
# their backend) or mupdate (the list of which mailbox is on which backend).
CYRUS_ROLE="${CYRUS_ROLE:-standalone}"
# This server's own name in the Murder (what frontends connect to); the public
# name otherwise.
CYRUS_SERVERNAME="${CYRUS_SERVERNAME:-$MAIL_HOSTNAME}"
export MAIL_HOSTNAME CYRUS_SERVERNAME
case "$CYRUS_ROLE" in
  standalone) ;;
  backend|frontend) : "${MURDER_MUPDATE_HOST:?MURDER_MUPDATE_HOST is required in a Murder}" ;;
  mupdate) ;;
  *) echo "CYRUS_ROLE must be standalone, backend, frontend or mupdate" >&2; exit 1 ;;
esac
if [ "$CYRUS_ROLE" = frontend ]; then : "${MURDER_BACKENDS:?MURDER_BACKENDS (the backends' names) is required on a frontend}"; fi

log() { echo "[cyrus-entrypoint] $*"; }

# Secrets for one purpose each, derived from INTERNAL_API_TOKEN (the API
# derives the same; see apps/api/src/config/internal-secrets.ts).
internal_secret() { printf 'postarix:%s' "$1" | openssl dgst -sha256 -hmac "$INTERNAL_API_TOKEN" -r | cut -d' ' -f1; }
MAIL_AUTH_SECRET=$(internal_secret mail-auth)
CYRUS_SMTP_SECRET=$(internal_secret cyrus-smtp)
# Murder: backends publish their mailboxes to mupdate, frontends log in to
# backends on behalf of users. Internal accounts, never valid on public ports.
MUPDATE_SECRET=$(internal_secret murder-mupdate)
PROXY_SECRET=$(internal_secret murder-proxy)

# --- Configuration -----------------------------------------------------------
envsubst '${CYRUS_SERVERNAME}' < /etc/imapd.conf.template > /etc/imapd.conf

# --- Cyrus Murder ------------------------------------------------------------
murder_client() {
  echo "mupdate_server: $MURDER_MUPDATE_HOST"
  echo "mupdate_port: 3905"
  echo "mupdate_config: standard"
  echo "mupdate_authname: postarix-mupdate"
  echo "mupdate_password: $MUPDATE_SECRET"
}
# Internal accounts live in a sasldb of their own (realm: this server's name).
murder_accounts() {
  rm -f /etc/sasldb2-murder
  for account in "$@"; do
    case "$account" in
      postarix-mupdate) secret=$MUPDATE_SECRET ;;
      postarix-murder) secret=$PROXY_SECRET ;;
    esac
    printf '%s' "$secret" | saslpasswd2 -p -c -u "$CYRUS_SERVERNAME" -f /etc/sasldb2-murder "$account"
  done
  chown root:sasl /etc/sasldb2-murder
  chmod 0640 /etc/sasldb2-murder
}
case "$CYRUS_ROLE" in
  backend)
    # Only frontends, the API and Postfix reach a backend (never clients):
    # its services may take plain-text logins on the internal network, and
    # the internal accounts are valid here, from their own sasldb.
    {
      sed -e 's/^sasl_pwcheck_method:.*/sasl_pwcheck_method: saslauthd auxprop/' \
          -e 's/^allowplaintext:.*/allowplaintext: yes/' /etc/imapd.conf
      echo "sasl_sasldb_path: /etc/sasldb2-murder"
      murder_client
      echo "proxyservers: postarix-murder"
      # Frontends deliver over LMTP as this account (per-service option: the service is "lmtpnet").
      echo "lmtpnet_admins: postarix-murder"
    } > /etc/imapd.conf.new
    mv /etc/imapd.conf.new /etc/imapd.conf
    murder_accounts postarix-murder
    # Services frontends connect to, on their standard ports; and the
    # backend publishes its mailboxes to mupdate at start.
    sed -i -e 's|^START {|START {\n  mupdatepush   cmd="ctl_mboxlist -m"|' \
      -e 's|^SERVICES {|SERVICES {\n  pop3          cmd="pop3d -U 30" listen="0.0.0.0:110" prefork=0 maxchild=50\n  lmtpnet       cmd="lmtpd -C /etc/imapd-lmtp.conf" listen="0.0.0.0:24" prefork=1 maxchild=20\n  httpnet       cmd="httpd -U 30" listen="0.0.0.0:80" prefork=1 maxchild=100|' /etc/cyrus.conf
    ;;
  frontend)
    {
      cat /etc/imapd.conf
      murder_client
      echo "serverlist: $MURDER_BACKENDS"
      echo "proxy_authname: postarix-murder"
      echo "proxy_password: $PROXY_SECRET"
      # ManageSieve: pass connections on to the backend instead of referring
      # clients to it (backends are not reachable by clients).
      echo "sieve_allowreferrals: no"
    } > /etc/imapd.conf.new
    mv /etc/imapd.conf.new /etc/imapd.conf
    # A local copy of the mailbox list, kept in sync by mupdate (slave). No
    # mailboxes, so no admin IMAP or JMAP service here: the API reaches the
    # backends directly.
    sed -i -e '/^  imapadmin /d' -e '/^  jmap /d' -e '/^  squatter /d' \
      -e 's|^SERVICES {|SERVICES {\n  mupdate       cmd="mupdate" listen="3905" prefork=1|' /etc/cyrus.conf
    ;;
  mupdate)
    {
      sed -e 's/^sasl_pwcheck_method:.*/sasl_pwcheck_method: auxprop/' -e 's/^allowplaintext:.*/allowplaintext: yes/' /etc/imapd.conf
      echo "sasl_sasldb_path: /etc/sasldb2-murder"
      echo "mupdate_config: standard"
      echo "admins: postarix-mupdate"
    } > /etc/imapd.conf.new
    mv /etc/imapd.conf.new /etc/imapd.conf
    murder_accounts postarix-mupdate
    cat > /etc/cyrus.conf <<'CONF'
# Cyrus Murder mupdate server: the list of mailboxes and their backends.
START {
  recover       cmd="/usr/sbin/cyrus ctl_cyrusdb -r"
}
SERVICES {
  mupdate       cmd="mupdate -m" listen="0.0.0.0:3905" prefork=1
}
EVENTS {
  checkpoint    cmd="/usr/sbin/cyrus ctl_cyrusdb -c" period=30
}
CONF
    ;;
esac
# Admin rights, and the sasldb that holds the admin password, exist only in the
# configuration of the internal admin service.
{
  sed -e 's/^sasl_pwcheck_method:.*/sasl_pwcheck_method: auxprop/' -e '/^sasl_sasldb_path:/d' -e '/^admins:/d' /etc/imapd.conf
  echo "admins: cyrus"
} > /etc/imapd-admin.conf
# The JMAP service: JMAP (mail, calendars, contacts; the DAV modules provide
# the calendar and contact stores behind JMAP), plain HTTP on the internal network. The API logs
# in as the user with a short-lived token it mints itself (checked through
# saslauthd like any other login).
# It never sends mail itself: EmailSubmission is refused by the API (and the
# smtp_backend settings inherited from imapd.conf make any attempt fail fast).
# Its logins go to a saslauthd instance of its own, which the API recognizes
# and for which it accepts nothing but its tokens (no app passwords).
sed -e 's/^httpmodules:.*/httpmodules: caldav carddav jmap/' \
    -e 's/^allowplaintext:.*/allowplaintext: yes/' \
    -e 's/^sasl_pwcheck_method:.*/sasl_pwcheck_method: saslauthd/' -e '/^sasl_sasldb_path:/d' \
    -e 's|^sasl_saslauthd_path:.*|sasl_saslauthd_path: /run/saslauthd-jmap/mux|' /etc/imapd.conf > /etc/imapd-jmap.conf
# Contacts over JMAP are a Cyrus extension (the IETF JMAP for Contacts
# capability is not in this Cyrus version yet).
echo 'jmap_nonstandard_extensions: yes' >> /etc/imapd-jmap.conf
# The JMAP service listens on the internal network address only.
sed -i "s/listen=\"0.0.0.0:8008\"/listen=\"${JMAP_LISTEN_ADDRESS:-127.0.0.1}:8008\"/" /etc/cyrus.conf
# Readable by Cyrus (group mail) only: in a Murder they hold internal passwords.
chown root:mail /etc/imapd.conf /etc/imapd-admin.conf /etc/imapd-jmap.conf
chmod 0640 /etc/imapd.conf /etc/imapd-admin.conf /etc/imapd-jmap.conf

# Mail Cyrus sends by itself (Sieve redirect and vacation replies) is sent by
# lmtpd only, through a Postfix port kept for it (10588; Rspamd checks it, see
# rspamd.local.lua). Every other service keeps the closed port of imapd.conf.
# Postfix gives redirected mail an envelope sender on the server's own name.
{
  grep -v -e '^smtp_host:' /etc/imapd.conf
  echo "smtp_host: ${CYRUS_SMTP_HOST:-postfix:10588}"
  echo "smtp_auth_authname: postarix-cyrus"
  echo "smtp_auth_password: $CYRUS_SMTP_SECRET"
} > /etc/imapd-lmtp.conf
chown root:mail /etc/imapd-lmtp.conf
chmod 0640 /etc/imapd-lmtp.conf

# --- Login bridge to the API (read by pam_exec as root only) -----------------
umask 077
mkdir -p /etc/postarix
printf 'POSTARIX_API_INTERNAL=%s\nMAIL_HOSTNAME=%s\n' "$POSTARIX_API_INTERNAL" "$MAIL_HOSTNAME" > /etc/postarix/mail-auth.env
printf 'x-postarix-internal-token: %s\n' "$MAIL_AUTH_SECRET" > /etc/postarix/mail-auth.headers
umask 022

# --- TLS ------------------------------------------------------------------------
# Certificates come from the shared /certs volume (managed by the certs service).
install_certificates() {
  install -d -o cyrus -g mail -m 0750 /etc/cyrus-tls
  if [ -s "$CERT_DIR/fullchain.pem" ] && [ -s "$CERT_DIR/privkey.pem" ]; then
    install -o cyrus -g mail -m 0600 "$CERT_DIR/privkey.pem" /etc/cyrus-tls/privkey.pem
    install -o cyrus -g mail -m 0644 "$CERT_DIR/fullchain.pem" /etc/cyrus-tls/fullchain.pem
    return 0
  fi
  return 1
}
if ! install_certificates; then
  log "no certificate in $CERT_DIR; generating a self-signed one (development only)"
  openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj "/CN=$MAIL_HOSTNAME" \
    -addext "subjectAltName=DNS:$MAIL_HOSTNAME" \
    -keyout /etc/cyrus-tls/privkey.pem -out /etc/cyrus-tls/fullchain.pem 2>/dev/null
  chown cyrus:mail /etc/cyrus-tls/*.pem
  chmod 0600 /etc/cyrus-tls/privkey.pem
fi

# --- Internal admin account (sasldb; realm = servername) ---------------------
printf '%s' "$CYRUS_ADMIN_PASSWORD" | saslpasswd2 -p -c -u "$CYRUS_SERVERNAME" -f /etc/sasldb2 cyrus
chown root:sasl /etc/sasldb2
chmod 0640 /etc/sasldb2

# Both secrets now live in root-only files; no process started below needs them.
unset CYRUS_ADMIN_PASSWORD INTERNAL_API_TOKEN MAIL_AUTH_SECRET CYRUS_SMTP_SECRET MUPDATE_SECRET PROXY_SECRET

# --- Runtime and data directories ---------------------------------------------
install -d -o cyrus -g mail -m 0750 /run/cyrus /run/cyrus/proc /run/cyrus/lock /run/cyrus/socket
# Shared with Postfix (a volume): Postfix must be able to traverse it.
install -d -o cyrus -g mail -m 0755 /run/cyrus/lmtp
rm -f /run/cyrus/lmtp/lmtp
install -d -o cyrus -g mail -m 0750 /var/lib/cyrus /var/lib/cyrus/search /var/spool/cyrus /var/spool/cyrus/mail /var/spool/sieve
/usr/lib/cyrus/bin/makedirs >/dev/null
chown -R cyrus:mail /var/lib/cyrus /var/spool/cyrus /var/spool/sieve

# --- Logging: Cyrus logs to syslog; forward it to stdout ----------------------
rm -f /dev/log /run/rsyslogd.pid
mkdir -p /var/log/postarix
rsyslogd -n -f /etc/rsyslog-postarix.conf -i /run/rsyslogd.pid &
# Rotate the shared log file past 20 MB (one old copy); SIGHUP reopens it.
(
  while sleep 300; do
    if [ "$(stat -c %s /var/log/postarix/cyrus.log 2>/dev/null || echo 0)" -gt 20971520 ]; then
      mv -f /var/log/postarix/cyrus.log /var/log/postarix/cyrus.log.1
      kill -HUP "$(cat /run/rsyslogd.pid)" 2>/dev/null || true
    fi
  done
) &

# --- saslauthd (shared with Postfix through the /run/saslauthd volume) -------
# -r passes "user@realm" to PAM. No credential cache (-c): revocations apply at once.
mkdir -p /run/saslauthd
chmod 0755 /run/saslauthd
rm -f /run/saslauthd/mux /run/saslauthd/saslauthd.pid
saslauthd -a pam -r -m /run/saslauthd -n 4
# The JMAP service's own instance (inside this container only).
install -d -m 0755 /run/saslauthd-jmap
rm -f /run/saslauthd-jmap/mux /run/saslauthd-jmap/saslauthd.pid
POSTARIX_SASL_INSTANCE=jmap saslauthd -a pam -r -m /run/saslauthd-jmap -n 2

# Reload when the certificate is renewed: SIGHUP makes the master process
# restart its services, and new connections use the new certificate.
(
  while sleep 60; do
    if [ -s "$CERT_DIR/fullchain.pem" ] && ! cmp -s "$CERT_DIR/fullchain.pem" /etc/cyrus-tls/fullchain.pem; then
      install_certificates && kill -HUP 1 && log "certificate changed; Cyrus reloaded"
    fi
  done
) &

log "starting Cyrus ($CYRUS_ROLE, $CYRUS_SERVERNAME) for $MAIL_HOSTNAME"
exec /usr/sbin/cyrmaster -D -M /etc/cyrus.conf -C /etc/imapd.conf
