#!/bin/sh
# Called by pam_exec (via saslauthd) for every mail login.
# The password arrives on stdin; PAM_USER and PAM_SERVICE identify the attempt.
# Exit 0 = accept, anything else = reject.
set -u
[ "${PAM_TYPE:-auth}" = "auth" ] || exit 0

. /etc/postarix/mail-auth.env

status=$(
  tr -d '\000' | curl --silent --show-error --max-time 10 \
    --output /dev/null --write-out '%{http_code}' \
    --header @/etc/postarix/mail-auth.headers \
    --data-urlencode "username=${PAM_USER:-}" \
    --data-urlencode "service=${PAM_SERVICE:-}" \
    --data-urlencode "password@-" \
    "${POSTARIX_API_URL}/api/internal/mail-auth"
) || exit 1

[ "$status" = "204" ]
