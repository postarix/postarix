#!/bin/sh
# Called by pam_exec (via saslauthd) for every mail login.
# The password arrives on stdin; PAM_USER and PAM_SERVICE identify the attempt.
# Exit 0 = accept, anything else = reject.
set -u
[ "${PAM_TYPE:-auth}" = "auth" ] || exit 0

. /etc/postarix/mail-auth.env

# Which saslauthd instance asks: the JMAP service's own runs with
# POSTARIX_SASL_INSTANCE=jmap in its environment (pam_exec does not pass it on,
# so read it from the parent process, the saslauthd worker).
instance=$(tr '\000' '\n' <"/proc/$PPID/environ" 2>/dev/null | sed -n 's/^POSTARIX_SASL_INSTANCE=//p' | head -n 1)

# Over TLS to the API's internal listener, which presents the mail server's
# certificate: it is checked against MAIL_HOSTNAME while connecting to the
# API's internal address, so passwords never cross the network in clear.
port=${POSTARIX_API_INTERNAL##*:}
status=$(
  tr -d '\000' | curl --silent --show-error --max-time 10 --proto '=https' \
    --connect-to "${MAIL_HOSTNAME}:${port}:${POSTARIX_API_INTERNAL}" \
    --cacert /etc/cyrus-tls/fullchain.pem --capath /etc/ssl/certs \
    --output /dev/null --write-out '%{http_code}' \
    --header @/etc/postarix/mail-auth.headers \
    --data-urlencode "username=${PAM_USER:-}" \
    --data-urlencode "service=${PAM_SERVICE:-}" \
    --data-urlencode "instance=${instance}" \
    --data-urlencode "password@-" \
    "https://${MAIL_HOSTNAME}:${port}/api/internal/mail-auth"
) || exit 1

[ "$status" = "204" ]
