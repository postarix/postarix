# Configuration for docker/compose/postarix.yml. Copy to postarix.env and fill in,
# or run deploy/scripts/generate-env.sh, which fills in the secrets for you.
# Generate each secret with:  openssl rand -base64 36 | tr -d '/+='

# The Postarix release to run (see the releases page), e.g. 1.0.0.
POSTARIX_VERSION=

# TLS certificate for Postfix and Cyrus: selfsigned (testing only), acme (Let's
# Encrypt; needs ACME_EMAIL, and the proxy routing the HTTP challenge, or a DNS
# provider), or external (your own files). See docker/certs/README.md.
CERTS_MODE=acme
ACME_EMAIL=

# Public name of the mail server (MX target, TLS certificate name).
MAIL_HOSTNAME=mail.example.com

# Public URL where the API is reachable through your reverse proxy.
AUTH_URL=https://mail.example.com

# Browser origins of the admin panel and webmail, comma-separated.
TRUSTED_ORIGINS=

# Identity providers (single sign-on) on a private network that organizations
# may use, comma-separated origins (e.g. https://idp.corp.internal). Public
# https providers need no entry.
SSO_TRUSTED_ISSUERS=

# Sender of the server's own notices (default: no-reply@MAIL_HOSTNAME).
SYSTEM_MAIL_FROM=

# Reverse proxies allowed to set X-Forwarded-For (IPs or CIDRs). A proxy on the
# postarix_proxy network: 172.30.54.0/24 (POSTARIX_PROXY_SUBNET).
TRUSTED_PROXIES=

# Secrets (all required)
POSTGRES_PASSWORD=
POSTFIX_DB_PASSWORD=
AUTH_SECRET=
CYRUS_ADMIN_PASSWORD=
INTERNAL_API_TOKEN=

# One secret per internal purpose, so each mail container gets only its own.
# deploy/scripts/derive-secrets.sh fills them in from INTERNAL_API_TOKEN.
POSTARIX_SECRET_MAIL_AUTH=
POSTARIX_SECRET_SUBMISSION=
POSTARIX_SECRET_CYRUS_SMTP=
POSTARIX_SECRET_MURDER_MUPDATE=
POSTARIX_SECRET_MURDER_PROXY=
POSTARIX_SECRET_MURDER_XFER=
RSPAMD_CONTROLLER_PASSWORD=
# Optional: the Rspamd web UI password that may change settings and learn
# spam. Unset: the controller is read-only.
RSPAMD_CONTROLLER_ENABLE_PASSWORD=
VALKEY_PASSWORD=

# API log format: text, or json (one JSON object per line, for log collectors).
LOG_FORMAT=text
