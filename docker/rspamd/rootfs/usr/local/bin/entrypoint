#!/bin/sh
# Renders runtime settings (Redis/Valkey, DNS resolver, controller password) and runs Rspamd.
set -eu

: "${RSPAMD_CONTROLLER_PASSWORD:?RSPAMD_CONTROLLER_PASSWORD is required}"
REDIS_SERVERS="${REDIS_SERVERS:-valkey:6379}"
DNS_RESOLVER="${DNS_RESOLVER:-unbound}"

# Rspamd needs IP addresses for its resolver.
resolver_ip=$(getent hosts "$DNS_RESOLVER" | awk '{print $1; exit}')
if [ -z "$resolver_ip" ]; then
  echo "[rspamd-entrypoint] cannot resolve $DNS_RESOLVER; using the system resolver" >&2
  : > /etc/rspamd/local.d/options.inc
else
  printf 'dns {\n  nameserver = ["%s:53"];\n}\n' "$resolver_ip" > /etc/rspamd/local.d/options.inc
fi
# Test environments only: POSTARIX_TEST_SPAM in a message body adds 8 points,
# enough to be marked as spam through the normal rules.
if [ "${RSPAMD_TEST_RULES:-false}" = "true" ]; then
  cat > /etc/rspamd/local.d/regexp.conf <<'RULES'
POSTARIX_TEST_SPAM {
  re = "/POSTARIX-TEST-SPAM-MARKER/{sa_body}";
  score = 8.0;
  description = "Test marker (test environments only)";
}
RULES
else
  rm -f /etc/rspamd/local.d/regexp.conf
fi

# Virus scanning with ClamAV (optional: the clamav profile / Helm clamav.enabled).
if [ -n "${CLAMAV_SERVERS:-}" ]; then
  cat > /etc/rspamd/local.d/antivirus.conf <<AV
clamav {
  type = "clamav";
  servers = "${CLAMAV_SERVERS}";
  symbol = "CLAM_VIRUS";
  # Attachments and the message itself.
  scan_mime_parts = true;
  scan_text_mime = false;
  scan_image_mime = false;
  action = "reject";
  message = '\${SCANNER}: virus found: "\${VIRUS}"';
  # If ClamAV cannot be reached, mail is still delivered (CLAM_VIRUS_FAIL
  # is logged with no score) rather than held up.
  log_clean = false;
  timeout = 30.0;
  retransmits = 2;
}
AV
  printf 'symbols = {\n  CLAM_VIRUS_FAIL = { score = 0.0; }\n}\n' > /etc/rspamd/local.d/antivirus_group.conf
else
  rm -f /etc/rspamd/local.d/antivirus.conf /etc/rspamd/local.d/antivirus_group.conf
fi

: "${REDIS_PASSWORD:?REDIS_PASSWORD is required}"
umask 027
printf 'servers = "%s";\npassword = "%s";\n' "$REDIS_SERVERS" "$REDIS_PASSWORD" > /etc/rspamd/local.d/redis.conf
chgrp _rspamd /etc/rspamd/local.d/redis.conf
umask 022

# The controller (web UI and API) only ever stores hashes of the passwords.
# RSPAMD_CONTROLLER_PASSWORD (the API's, for the filtering history) is
# read-only; changes (learning, settings) need RSPAMD_CONTROLLER_ENABLE_PASSWORD,
# and are disabled when it is unset (a random password nobody knows).
hash=$(rspamadm pw -p "$RSPAMD_CONTROLLER_PASSWORD")
enable_hash=$(rspamadm pw -p "${RSPAMD_CONTROLLER_ENABLE_PASSWORD:-$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')}")
printf 'bind_socket = "*:11334";\npassword = "%s";\nenable_password = "%s";\n' \
  "$hash" "$enable_hash" > /etc/rspamd/local.d/worker-controller.inc
unset RSPAMD_CONTROLLER_PASSWORD RSPAMD_CONTROLLER_ENABLE_PASSWORD

# Greylisting can be disabled (e.g. in test environments) with RSPAMD_GREYLIST=false.
mkdir -p /etc/rspamd/override.d
if [ "${RSPAMD_GREYLIST:-true}" = "false" ]; then
  echo 'enabled = false;' > /etc/rspamd/override.d/greylist.conf
else
  rm -f /etc/rspamd/override.d/greylist.conf
fi

install -d -o _rspamd -g _rspamd /var/lib/rspamd /run/rspamd
exec postarix-logged rspamd /var/lib/rspamd "$(rspamd --version 2>/dev/null | head -n 1)" -- rspamd -f -u _rspamd -g _rspamd
